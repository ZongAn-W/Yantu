{
  "name": "sjtu-study-planner",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "workspaces": [
    "apps/api",
    "apps/web",
    "apps/desktop",
    "packages/planner-engine"
  ],
  "scripts": {
    "dev": "npm run dev -w apps/web -- --host 127.0.0.1",
    "api:dev": "npm run dev -w @planner/api",
    "api:build": "npm run build -w @planner/api",
    "api:start": "npm run start -w @planner/api",
    "desktop:dev": "tauri dev --config apps/desktop/src-tauri/tauri.conf.json",
    "desktop:build": "tauri build --config apps/desktop/src-tauri/tauri.conf.json",
    "desktop:test": "cargo test --manifest-path apps/desktop/src-tauri/Cargo.toml",
    "build": "tsc --noEmit && npm run build -w apps/web",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@tauri-apps/cli": "^2.12.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.10.0",
    "jsdom": "^29.1.1",
    "typescript": "^5.7.0",
    "vitest": "^3.2.0"
  }
}
