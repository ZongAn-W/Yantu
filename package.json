{
  "name": "sjtu-study-planner",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "workspaces": [
    "apps/api",
    "packages/planner-engine"
  ],
  "scripts": {
    "dev": "powershell.exe -NoLogo -NoProfile -File apps/flutter_client/tool/run-web.ps1",
    "api:dev": "npm run dev -w @planner/api",
    "api:build": "npm run build -w @planner/api",
    "api:start": "npm run start -w @planner/api",
    "build": "powershell.exe -NoLogo -NoProfile -File apps/flutter_client/tool/build-release.ps1 -Target Web",
    "deploy": "powershell.exe -NoLogo -NoProfile -ExecutionPolicy Bypass -File tools/deploy-server.ps1",
    "deploy:check": "powershell.exe -NoLogo -NoProfile -ExecutionPolicy Bypass -File tools/deploy-server.ps1 -CheckOnly",
    "deploy:key": "powershell.exe -NoLogo -NoProfile -ExecutionPolicy Bypass -File tools/setup-deploy-key.ps1",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p apps/api/tsconfig.json"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0",
    "vitest": "^3.2.0"
  }
}
