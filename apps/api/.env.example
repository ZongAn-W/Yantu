PORT=8787
DATABASE_URL=postgres://planner:planner@localhost:5432/planner
# bing uses public RSS search; brave/tavily require a backend-only API key. Use disabled to turn off research.
RESEARCH_SEARCH_PROVIDER=bing
RESEARCH_SEARCH_API_KEY=
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
WEB_ORIGIN=http://127.0.0.1:5180
AI_BASE_URL=https://api.deepseek.com
AI_API_KEY=
AI_MODEL=deepseek-flash
AI_REASONING_EFFORT=max
# Onboarding interviews, time suggestions and course editing use the simple tier.
AI_SIMPLE_REASONING_EFFORT=low
# Item generation, item revisions and quality repairs use the planning tier.
AI_PLANNING_REASONING_EFFORT=high
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=
# QQ mailbox SMTP authorization code, not the QQ account password.
SMTP_PASS=
# Optional: defaults to SMTP_USER.
SMTP_FROM=
