# Copy to apps/web/.env.local. Leave blank to use the localStorage Demo.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Or use the newer public key name:
# VITE_SUPABASE_PUBLISHABLE_KEY=
# Do not put a Supabase service_role/secret key in a browser app.
# Set this to the Node API origin to enable registration, onboarding and AI planning.
# VITE_API_URL=http://127.0.0.1:8787
