{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "研途学习工作台",
  "version": "1.0.0",
  "identifier": "cn.sjtu.studyplanner",
  "build": {
    "beforeDevCommand": "npm run dev -w apps/web -- --host 127.0.0.1",
    "beforeBuildCommand": "npm run build -w apps/web",
    "devUrl": "http://127.0.0.1:5173",
    "frontendDist": "../../web/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "研途 · 上海交大 408 学习工作台",
        "width": 1280,
        "height": 820,
        "minWidth": 760,
        "minHeight": 560,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "windows": { "webviewInstallMode": { "type": "downloadBootstrapper" } }
  }
}
