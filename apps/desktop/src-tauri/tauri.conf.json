{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "不白学",
  "version": "1.0.0",
  "identifier": "cn.sjtu.studyplanner",
  "build": {
    "beforeDevCommand": "npm run dev -w apps/web -- --host 127.0.0.1 --port 1420",
    "beforeBuildCommand": "npm run build -w apps/web",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../../web/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "不白学 · 考研执行台",
        "width": 1280,
        "height": 820,
        "minWidth": 760,
        "minHeight": 560,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "windows": {
      "webviewInstallMode": { "type": "offlineInstaller" },
      "nsis": { "languages": ["SimpChinese"] },
      "wix": { "language": "zh-CN" }
    }
  }
}
