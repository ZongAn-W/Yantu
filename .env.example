# Copy apps/web/.env.example to apps/web/.env.local; Vite reads env files from apps/web.
# Leave both values blank for the complete localStorage Demo mode.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# New Supabase projects can use a publishable key instead of the legacy anon key.
# VITE_SUPABASE_PUBLISHABLE_KEY=
# Never use a service_role / secret key in a browser environment.
