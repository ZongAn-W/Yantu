# The server reads apps/api/.env; use apps/api/.env.example as its template.
# Flutter receives the public API URL at compile time, not from a root .env file:
# npm run dev -- -ApiBaseUrl http://127.0.0.1:8787
# npm run build -- -ApiBaseUrl https://api.example.com
# Keep database credentials, JWT secrets, AI keys and SMTP credentials on the server.
